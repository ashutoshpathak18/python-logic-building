# Decreasing Triangle

n = int(input("Enter the number of rows of the triangle :"))

for i in range(n,0,-1):
    print("*"*i)


# Number Triangle

n = int(input("Enter the number of rows of the triangle :"))

for i in range(1,n+1):
    print(f"{i}"*i)
